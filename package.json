{
  "name": "tikzcd-katex",
  "version": "0.3.0",
  "type": "module",
  "description": "A minimal tikzcd extension for KaTeX.",
  "license": "MIT",
  "main": "dist/tikzcd-katex.js",
  "files": [
    "dist/",
    "src/",
    "scripts/",
    "tsconfig.json",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28",
    "katex": "0.19",
    "typescript": "7"
  }
}